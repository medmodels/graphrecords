class PyExpression(_Surface):
    def cache(self) -> Self: ...
    def explain(self) -> str: ...

class PySeries(_Surface):
    def cache(self) -> Self: ...
    def evaluate(self) -> object: ...
    def explain(self) -> str: ...
    def explain_unoptimized(self) -> str: ...

def nodes() -> PyExpression: ...
def edges() -> PyExpression: ...
def groups() -> PyExpression: ...

