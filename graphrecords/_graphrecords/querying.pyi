from typing import (
    Any,
    Iterable,
    Iterator,
    List,
    Optional,
    Tuple,
    TypeAlias,
    Union,
)

from typing_extensions import Self

from graphrecords._graphrecords.graphrecord import PyEdgeDirection, PyEdgeIndex
from graphrecords.types import AttributeName, GroupIndex, Value

Argument: TypeAlias = Union[
    Value,
    PyExpression,
    PySeries,
    PyArgument,
    PyFailureKind,
    PyEdgeIndex,
    PyEdgeEndpointRole,
]
MaskArgument: TypeAlias = Union[
    bool,
    PyExpression,
    PySeries,
    PyArgument,
]
PopulationArgument: TypeAlias = Union[
    PyExpression,
    PySeries,
]
SetArgument: TypeAlias = Union[
    Iterable[Union[Value, PyEdgeIndex, PyFailureKind, PyEdgeEndpointRole]],
    PyExpression,
    PySeries,
    PyArgument,
]

class PyEdgeEndpointRole:
    Source: PyEdgeEndpointRole
    Target: PyEdgeEndpointRole

    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class PyCastTarget:
    Bool: PyCastTarget
    DateTime: PyCastTarget
    Duration: PyCastTarget
    Float: PyCastTarget
    Int: PyCastTarget
    String: PyCastTarget

    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class PyValueTarget:
    Value: PyValueTarget
    ValueIndex: PyValueTarget
    AttributeName: PyValueTarget
    AttributeNameIndex: PyValueTarget
    NodeIndex: PyValueTarget
    GroupIndex: PyValueTarget
    PositionalIndex: PyValueTarget
    BoolIndex: PyValueTarget
    Mask: PyValueTarget
    FailureKind: PyValueTarget
    FailureKindIndex: PyValueTarget

    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class PyFailureKind:
    @property
    def name(self) -> str: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class PyArgument: ...

class PyResultView:
    def __iter__(self) -> PyResultView: ...
    def __next__(self) -> object: ...

class PyGroupedResult:
    @property
    def key_failures(self) -> List[Tuple[Any, Any]]: ...
    def __len__(self) -> int: ...
    def __contains__(self, key: object) -> bool: ...
    def __getitem__(self, key: object) -> object: ...
    def __iter__(self) -> Iterator[Any]: ...
    def keys(self) -> List[Any]: ...

